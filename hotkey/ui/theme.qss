* {
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 9pt;
}

QMainWindow,
QWidget {
    background-color: $bg;
    color: $text;
}

QFrame#titleBar {
    background-color: $surface;
    border-bottom: 1px solid $border;
}

QLabel#titleText {
    color: $text;
    font-size: 10pt;
    font-weight: bold;
    padding-left: 2px;
}

QToolButton#titleButton {
    background: transparent;
    border: 0;
    border-radius: 4px;
    padding: 0;
}

QToolButton#titleButton:hover {
    background-color: $surface_alt;
}

QToolButton#titleClose {
    background: transparent;
    border: 0;
    border-radius: 4px;
    padding: 0;
}

QToolButton#titleClose:hover {
    background-color: $danger;
}

QToolButton#titleMenuButton {
    background: transparent;
    color: $text;
    border: 0;
    border-radius: 4px;
    font-size: 10pt;
    padding: 0 7px;
}

QToolButton#titleMenuButton:hover {
    background-color: $surface_alt;
}

QToolButton#titleMenuButton::menu-indicator {
    image: none;
    width: 0;
}

QToolButton#paletteToggle {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
    border-radius: 4px;
    font-size: 9pt;
}

QToolButton#paletteToggle:hover {
    background-color: $surface_high;
}

QMenuBar {
    background: transparent;
    color: $text;
    border: 0;
    padding-left: 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: $surface_alt;
}

QMenu {
    background-color: $surface;
    border: 1px solid $border;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: $selection;
    color: $text;
}

QMenu::separator {
    height: 1px;
    background-color: $border;
    margin: 4px 8px;
}

QTabBar#editorTabs {
    background: transparent;
}

QTabBar#editorTabs::tab {
    background-color: $surface_alt;
    color: $muted;
    border: 1px solid $border;
    border-bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 5px 10px;
    margin-right: 2px;
}

QTabBar#editorTabs::tab:selected {
    background-color: $surface;
    color: $text;
}

QTabBar#editorTabs::tab:hover:!selected {
    background-color: $surface_high;
}

QToolButton#btnNewFile {
    background: transparent;
    color: $muted;
    border: 1px dashed $border;
    border-radius: 4px;
    font-size: 12pt;
    min-width: 24px;
    min-height: 22px;
}

QToolButton#btnNewFile:hover {
    background-color: $surface_alt;
    color: $accent;
}

QLineEdit {
    background-color: $input_bg;
    color: $text;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: $accent;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: $accent;
}

QKeySequenceEdit {
    background-color: $input_bg;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 4px 6px;
}

QTableView {
    background-color: $surface;
    alternate-background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
    border-radius: 4px;
    selection-background-color: $selection;
    selection-color: $text;
    gridline-color: $border;
}

QHeaderView::section {
    background-color: $surface_high;
    color: $text;
    border: 0;
    padding: 6px 8px;
    font-weight: bold;
}

QTreeWidget {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 4px;
    outline: 0;
    padding: 4px;
}

QTreeWidget::item {
    padding: 4px 2px;
}

QTreeWidget::item:selected {
    background-color: $accent;
    color: #ffffff;
    border-radius: 3px;
}

QPushButton {
    background-color: $accent;
    color: #ffffff;
    border: 0;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: $accent_hover;
}

QPushButton:pressed {
    background-color: $accent_hover;
}

QPushButton:disabled {
    background-color: $surface_high;
    color: $muted;
}

QSplitter::handle {
    background-color: $border;
    width: 1px;
}

QStatusBar {
    background-color: $surface;
    color: $muted;
    border-top: 1px solid $border;
}

QScrollArea#blockEditor {
    background-color: $bg;
    border: 1px solid $border;
    border-radius: 4px;
}

QLabel#lblEditing {
    font-weight: bold;
    color: $text;
}

QFrame#blockWidget {
    background-color: $surface_alt;
    border: 1px solid $border;
    border-left: 4px solid $accent;
    border-radius: 8px;
}

QFrame#blockWidget[dropPosition="before"] {
    border-top: 3px solid $accent;
}

QFrame#blockWidget[dropPosition="after"] {
    border-bottom: 3px solid $accent;
}

QFrame#blockWidget[compact="true"] {
    background-color: $surface_high;
    border: 1px solid $border;
    border-left: 3px solid $accent;
    border-radius: 4px;
}

QFrame#valueSlot {
    background-color: $input_bg;
    border: 1px solid $border;
    border-radius: 4px;
}

QPushButton#keyCapture {
    background-color: $input_bg;
    color: $text;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 2px 8px;
    text-align: left;
}

QPushButton#keyCapture:hover {
    border-color: $accent;
}

QPushButton#keyCapture:pressed {
    background-color: $surface_alt;
}

QPlainTextEdit#pythonCode {
    background-color: $input_bg;
    color: $text;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 4px;
    font-family: "Consolas", "Cascadia Mono", monospace;
}

QFrame#valueSlot QLineEdit {
    background: transparent;
    border: 0;
    padding: 1px 3px;
}

QComboBox#valueMode {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
    border-radius: 3px;
    padding: 1px 2px;
    font-size: 8pt;
}

QLabel#blockDragHandle {
    color: $muted;
    font-size: 12pt;
    font-weight: bold;
}

QLabel#blockDragHandle:hover {
    color: $accent;
}

QFrame#blockBody {
    background-color: $surface_high;
    border-radius: 4px;
}

QFrame#blockWidget QLabel {
    background: transparent;
    color: $text;
    font-size: 10pt;
}

QFrame#blockWidget QLineEdit {
    background-color: $input_bg;
    color: $text;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 1px 6px;
    min-height: 22px;
    font-size: 10pt;
    selection-background-color: $accent;
    selection-color: #ffffff;
}

QFrame#blockWidget QToolButton {
    background: transparent;
    color: $muted;
    border: 0;
    font-size: 11pt;
}

QFrame#blockWidget QToolButton:hover {
    background: $surface_high;
    color: $danger;
    border-radius: 4px;
}

QLabel#bodyLabel {
    color: $muted;
    font-size: 9pt;
    font-weight: bold;
}

QLabel#bodyHint {
    color: $muted;
    background: $surface_alt;
    border: 1px dashed $border;
    border-radius: 4px;
    padding: 6px;
}

QDialog {
    background-color: $bg;
}

QToolTip {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
    padding: 4px 6px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: $surface_high;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: $accent;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: $surface_high;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: $accent;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
